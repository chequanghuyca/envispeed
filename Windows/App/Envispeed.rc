#include <windows.h>
#include <winver.h>
#include "resource.h"
#include "Version.h"
IDI_APP ICON "Envispeed.ico"
1 24 "Envispeed.manifest"
IDR_SOUND_VI RCDATA "Sounds/SwitchToVietnamese.wav"
IDR_SOUND_EN RCDATA "Sounds/SwitchToEnglish.wav"
IDR_EMOJI_JSON RCDATA "../../App/Resources/Emoji.json"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION ENVISPEED_VERSION_NUM
 PRODUCTVERSION ENVISPEED_VERSION_NUM
 FILEOS 0x40004L
 FILETYPE 0x1L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Che Quang Huy"
      VALUE "FileDescription", "Envispeed - Vietnamese typing"
      VALUE "FileVersion", ENVISPEED_VERSION
      VALUE "InternalName", "Envispeed"
      VALUE "LegalCopyright", "GPL-3.0. Based on Vikey by Tony Dinh and contributors, and OpenKey by Tuyen Mai."
      VALUE "OriginalFilename", "Envispeed.exe"
      VALUE "ProductName", "Envispeed"
      VALUE "ProductVersion", ENVISPEED_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
